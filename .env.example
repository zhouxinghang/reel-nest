# Docker publishes the service on LAN interfaces. Restrict with a host firewall.
HOST_BIND=0.0.0.0
HOST_PORT=8090
HOUSEHOLD_USERNAME=family
# Set true only behind same-origin HTTPS; HTTP LAN development requires false.
COOKIE_SECURE=false
# Optional media mount; compose.media.yaml is read-only.
# Opt-in permanent deletion: use compose.media-write.yaml instead; see README.
# MEDIA_HOST_PATH=/absolute/path/to/host-mounted/media
# Optional TMDB: use your own API Read Access Token (not a v3 API key).
# Local: TMDB_READ_ACCESS_TOKEN_FILE=/absolute/path/to/secrets/tmdb_read_access_token.txt
# Docker: add -f compose.tmdb.yaml; see README for the optional secret file.
# Optional TVDB v4: your own API key, plus PIN only for user-supported keys.
# Local: TVDB_API_KEY_FILE=/absolute/path/to/secrets/tvdb_api_key.txt
# Local: TVDB_PIN_FILE=/absolute/path/to/secrets/tvdb_pin.txt
# Docker: add -f compose.tvdb.yaml; optional TVDB_PIN in your private .env.
# Optional self-hosted MetaTube (movie metadata only; opt in per directory).
# METATUBE_URL=http://192.168.1.20:8080
# METATUBE_TOKEN_FILE=/absolute/path/to/secrets/metatube_token.txt
# Or METATUBE_TOKEN=your-own-token (omit only when MetaTube authentication is off).
# Docker: add -f compose.metatube.yaml; set METATUBE_URL in your private .env.
