# Docker publishes the service on LAN interfaces. Restrict with a host firewall.
HOST_BIND=0.0.0.0
HOST_PORT=8090
HOUSEHOLD_USERNAME=family
# Set true only behind same-origin HTTPS; HTTP LAN development requires false.
COOKIE_SECURE=false
# Optional media mount; compose.media.yaml is read-only.
# Opt-in permanent deletion: use compose.media-write.yaml instead; see README.
# MEDIA_HOST_PATH=/absolute/path/to/host-mounted/media
# Metadata providers are configured in the authenticated /settings/metadata page.
# TMDB Token, TVDB API Key/PIN and MetaTube URL/Token persist in app_data.
